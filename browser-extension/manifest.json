{
  "manifest_version": 3,
  "name": "CourseFlow Meeting Bridge",
  "version": "0.1.0",
  "description": "在当前已登录的浏览器中为 CourseFlow 解析腾讯会议回放。",
  "key": "",
  "permissions": ["alarms", "cookies", "tabs", "webRequest"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://meeting.tencent.com/*",
    "https://*.tencent.com/*",
    "https://*.qcloud.com/*",
    "https://*.myqcloud.com/*",
    "https://*.tencent-cloud.net/*",
    "https://*.tencentcs.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "CourseFlow Meeting Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://meeting.tencent.com/*"],
    "js": ["title_utils.js", "content.js"],
    "run_at": "document_idle"
  }]
}
